{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Check and install updates and open the WeekLoom data directory from the main window",
  "windows": ["main"],
  "permissions": [
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$APPDATA" }] }
  ]
}
